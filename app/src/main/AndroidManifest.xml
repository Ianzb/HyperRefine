<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取作用域内任意应用的信息（图标 / 名称 / 版本）需要包可见性；
         作用域应用在运行期才确定，无法用 <queries> 预先声明，故保留该权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".TemplateApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.HyperRefine">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HyperRefine"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <!-- 桌面图标通过别名暴露：隐藏桌面图标时仅禁用该别名，
             MainActivity 仍保留 Xposed 模块设置入口（MODULE_SETTINGS）。 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:label="@string/third_party_licenses_title"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.AppearanceActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.GlassActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.DeviceCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.AppVolumeActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.TopBarActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.WeatherActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.ExperimentalActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.LayoutAdjustActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.VolumeBarActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.PercentStyleActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.CornerRadiusActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.SecurityCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.DeviceConnectActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.PasskeyActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.features.BrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.scope.ScopeListActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <activity
            android:name=".ui.screen.safemode.SafeModeActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperRefine" />
        <!-- 接收目标进程的 Hook 生效回报。来源经发送者 UID / 包名 / 版本校验。 -->
        <receiver
            android:name=".xposed.HookStatusReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="cn.ianzb.hyperrefine.action.HOOKS_ACTIVE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
